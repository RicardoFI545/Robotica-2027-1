<robot name="robot_inicial">
<!--Información de eslabones-->
<link name="0_link">
    <visual>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        <geometry>
            <box size="0.01 0.01 0.01"/>
        </geometry>
        <material name="negro">
            <color rgba="0.0 0.0 0.0 1.0"/>
        </material>
    </visual>
</link>

<link name="1_link">
    <visual>
        <origin xyz="0.25 0.0 0.0" rpy="0.0 0.0 0.0"/>
        <geometry>
            <mesh filename="link1.stl" scale="1.6666 1 1"/>
        </geometry>
        <material name="rojo">
            <color rgba="1 0.0 0.0 1.0"/>
        </material>
    </visual>
    <visual>
        <origin xyz="0.25 0 0" rpy="0.0 0.0 0.0"/>
        <geometry>
            <sphere radius="0.01"/>
        </geometry>
        <material name="negro">
            <color rgba="0 0 0 1.0"/>
        </material>
    </visual>
</link>
<link name="2_link">
    <visual>
        <origin xyz="0.25 0.0 0.0" rpy="0.0 0.0 0.0"/>
        <geometry>
            <mesh filename="link1.stl" scale="1.6666 1 1"/>
        </geometry>
        <material name="verde">
            <color rgba="0.0 1 0.0 1.0"/>
        </material>
    </visual>
</link>
<link name="3_link">
    <visual>
        <origin xyz="0.25 0.0 0.0" rpy="0.0 0.0 0.0"/>
        <geometry>
            <mesh filename="link1.stl" scale="1.6666 1 1"/>
        </geometry>
        <material name="azul">
            <color rgba="0.0 0.0 1 1.0"/>
        </material>
    </visual>
</link>
<link name="p_link">
    <visual>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        <geometry>
            <box size="0.05 0.05 0.05"/>
        </geometry>
        <material name="negro">
            <color rgba="0.0 0.0 0.0 1.0"/>
        </material>
    </visual>
</link>
<!--Información de articulaciones-->
<joint name="1_joint" type="revolute">
    <origin xyz="0.0 0.0 0.0" rpy="1.57 0.0 0.0"/>
    <parent link="0_link"/>
    <child link="1_link"/>
    <axis xyz="0.0 0.0 1"/>
    <limit lower="-3.14" upper="3.14" effort="1.0" velocity="10.0"/>
</joint>
<joint name="2_joint" type="revolute">
    <origin xyz="0.5 0.0 0.0" rpy="0.0 0.0 0.0"/>
    <parent link="1_link"/>
    <child link="2_link"/>
    <axis xyz="0.0 0.0 1"/>
    <limit lower="-3.14" upper="3.14" effort="1.0" velocity="10.0"/>
</joint>
<joint name="3_joint" type="revolute">
    <origin xyz="0.5 0.0 0.0" rpy="0.0 0.0 0.0"/>
    <parent link="2_link"/>
    <child link="3_link"/>
    <axis xyz="0.0 0.0 1"/>
    <limit lower="-3.14" upper="3.14" effort="1.0" velocity="10.0"/>
</joint>
<joint name="p_joint" type="fixed">
    <origin xyz="0.5 0.0 0.0" rpy="0.0 0.0 0.0"/>
    <parent link="3_link"/>
    <child link="p_link"/>
</joint>
</robot>